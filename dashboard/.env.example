# Copy to .env.local for local development, and set the same values as
# Environment Variables in the Vercel project for production.

# Shared secret the VPS uses to push status. Generate a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# Redis-compatible REST store that holds live pipeline state.
# Create one in the Vercel dashboard (Storage -> KV) and these are injected
# automatically, or use Upstash directly and set the UPSTASH_* names instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash equivalents - only needed if you are not using Vercel KV.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
